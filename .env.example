# Copy to .env and fill in real values. Never commit .env.

# --- Môi trường ---
# development -> SeedRunner truncate + re-seed toàn bộ dữ liệu (kể cả bảng
# giao dịch orders/cart_items/...) ở MỌI lần khởi động (DB coi là disposable).
# Để trống hoặc "production" -> chỉ seed bảng còn trống (idempotent), không
# bao giờ đụng vào dữ liệu đã có. Chỉ set development trên DB có thể mất dữ liệu.
APP_ENV=production

# --- MySQL (service "db") ---
MYSQL_ROOT_PASSWORD=changeme
DB_USERNAME=root

# --- Local file storage ---
# Public domain/IP clients use to reach this server. Must NOT be localhost in
# production (image links returned to clients would be unreachable).
APP_STORAGE_PUBLIC_URL=http://localhost:8080

# --- JWT ---
# BẮT BUỘC: app refuses to start without this. Base64, must decode to >= 64 bytes
# (HS512). Generate with e.g. `openssl rand -base64 64`.
APP_JWT_SECRET=

# --- CORS ---
# BẮT BUỘC: app refuses to start without this. Comma-separated exact origins
# allowed to make credentialed cross-origin requests, e.g. http://localhost:5173
APP_CORS_ALLOWED_ORIGINS=

# --- Auth cookies (refresh token + CSRF) ---
# Cookie defaults to Secure=true (required for SameSite=None/HTTPS prod). Local dev
# runs over plain http://localhost, so the browser silently drops a Secure cookie —
# set this to false for local dev, leave unset (true) in prod. See docs/AUTH_USER_API.md.
APP_COOKIE_SECURE=false

# --- OAuth2 Google (optional) ---
GOOGLE_CLIENT_ID=

# --- Mail (optional) ---
MAIL_HOST=smtp.gmail.com
MAIL_USERNAME=
MAIL_PASSWORD=
APP_MAIL_FROM=
# Admin inbox that receives contact-request notification emails; leave empty to disable.
CONTACT_NOTIFY_EMAIL=

# --- VietQR payment ---
VIETQR_BASE_URL=https://vietqr.app/img
VIETQR_BANK=MBBank
VIETQR_ACCOUNT=
VIETQR_HOLDER=
VIETQR_TEMPLATE=compact

# --- SePay webhook ---
SEPAY_WEBHOOK_SECRET=
